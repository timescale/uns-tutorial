# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ── TimescaleDB ───────────────────────────────────────────────────────────────
TIMESCALE_DSN=postgresql://postgres:postgres@localhost:5432/uns_demo

# ── ingest.py ─────────────────────────────────────────────────────────────────
# Topic prefix to subscribe to (wildcard captures full ISA-95 hierarchy)
INGEST_TOPIC=acme_mfg/#
# Flush buffered readings to DB every N seconds
FLUSH_INTERVAL_SEC=5.0

# ── publisher.py ──────────────────────────────────────────────────────────────
# How fast each simulated device publishes (Hz)
PUBLISH_RATE_HZ=1

# ── edge-cases/duplicate-events.py ───────────────────────────────────────────
EXPERIMENT_UNIQUE_EVENTS=100
EXPERIMENT_DUPLICATE_EVENTS=30

# ── edge-cases/missing-fields.py ─────────────────────────────────────────────
EXPERIMENT_COMPLETE_READINGS=50
EXPERIMENT_INCOMPLETE_READINGS=10

# ── edge-cases/non-standard-enums.py ─────────────────────────────────────────
EXPERIMENT_STANDARD_EVENTS=50
EXPERIMENT_NONSTANDARD_EVENTS=10

# ── edge-cases/timezone-drift.py ─────────────────────────────────────────────
EXPERIMENT_UTC_READINGS=50
EXPERIMENT_NAIVE_READINGS=50
